/* ============================================ */
/*  Atlantico Server TUI - Minimal Dark Theme  */
/* ============================================ */

/* === GLOBAL STYLES === */
Screen {
    background: $surface;
    padding: 0 1;
}

/* === LAYOUT COMPONENTS === */
Header {
    dock: top;
    margin-bottom: 1;
    color: $text;
}

CustomFooter {
    dock: bottom;
    height: 3;
}

CustomFooter > Static {
    color: $text-muted;
    padding: 0 2;
    border: round $panel;
    content-align: left middle;
}

/* === BASE CONTAINERS === */

.panel {
    border: round $panel;
    padding: 1 0 0 4;
    border-title-color: $text-muted;
}

Horizontal {
    align-horizontal: left;
}

/* === COMMON WIDGETS === */
Button {
    min-width: 16;
    margin: 0 1;
    padding: 0 1;
}

Button:focus {
    text-style: bold underline;
    background: #000 !important;
}

Input {
    background: $surface;
    border: tall $panel;
    padding: 0 2;
}

Input:focus {
    border: tall $primary;
}

Input.-invalid {
    border: tall $error;
}

DataTable {
    background: $background;
    border: round $panel;
}

DataTable > .datatable--header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: $background;
}

DataTable > .datatable--even-row {
    background: $surface;
}

DataTable > .datatable--cursor {
    background: $boost;
}

DataTable:focus > .datatable--cursor {
    background: $primary;
    color: $text;
}

ProgressBar {
    background: $surface;
}

ProgressBar > .bar--bar {
    color: $success;
}

ProgressBar > .bar--complete {
    color: $success;
}

ProgressBar > .bar--indeterminate {
    color: $primary;
}

RichLog {
    background: $surface;
}

/* === UTILITY CLASSES === */


.gapper > * {
    margin-top: 1;
}

.gapper > *:first-child {
    margin-top: 0;
}

/* ============================================ */
/*  DASHBOARD SCREEN                           */
/* ============================================ */
ServerStatusPanel {
    height: 9;
}

QuickActionsPanel {
    height: 7;}

QuickActionsPanel > Horizontal {
    align-horizontal: center;
}

ActivityFeedPanel {
    height: 1fr;
    min-height: 15;
}

ActivityFeedPanel #activity-log {
    border: none;
    height: 1fr;
}

/* ============================================ */
/*  DEVICES SCREEN                             */
/* ============================================ */
#tables-container {
    height: 1fr;
}

#tables-container > Container {
    width: 1fr;
    height: 100%;
}

#all-devices-table,
#federated-devices-table {
    height: 1fr;
    min-height: 15;
}

.table-count {
    dock: bottom;
    height: 1;
    width: auto;
    
    layer: above;
    background: $background;
    color: $text-muted;
    padding: 0 1;
    margin: 0 2;
}

#device-info-panel {
    height: auto;
    margin-top: 0;
}

#device-info-content {
    padding: 0 1;
    height: auto;
}

/* ============================================ */
/*  FEDERATED LEARNING SCREEN                  */
/* ============================================ */

FederatedScreen .main-layout {
    overflow-y: auto; 
}

ConfigurationPanel {
    height: auto;
}

ConfigurationPanel > * {
    height: auto;
}

ConfigurationPanel Horizontal {
    margin-bottom: 1;
    height: auto;
}

ConfigurationPanel .config-label {
    width: 10;
    height: 3;
    content-align-vertical: middle;
}

ConfigurationPanel .config-input {
    margin-right: 12;
}

ConfigurationPanel #select-training-type {
    width: 100%;
}

#batch-file-tree {
    height: 10;
}

TrainingControlPanel {
    height: auto;
}

TrainingControlPanel .control-buttons {
    align-horizontal: center;
    height: auto;
}

ProgressPanel {
    min-height: 14;
}

ProgressPanel #training-status {
    margin-bottom: 2;
}

ProgressPanel .progress-bar {
    text-style: bold;
    margin-bottom: 1;
}

MetricsPanel {
    min-height: 8;
}

/* ============================================ */
/*  LOGS SCREEN                                */
/* ============================================ */
#log-count {   
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#log-display {
    height: 1fr;
    border: none;
    background: $surface;
    padding: 0;
}

#log-header {
    height: auto;
    margin-bottom: 1;
}

#log-header > * {
    width: auto;
    margin-right: 2;
    border: none;
}

#log-header #log-level-filter {
    width: 20;
}

#log-header #log-search {
    width: auto;
    height: auto;
}

/* ============================================ */
/*  SETTINGS SCREEN                             */
/* ============================================ */
SettingsScreen .panel {
    height: auto;
}

SettingsScreen .panel > * {
    margin-bottom: 1;
}

#switch-show-date {
    margin-bottom: 1;
}

/* ============================================ */
/*  METRICS SCREEN                              */
/* ============================================ */
#metrics-container {
    height: 100%;
    width: 100%;
}

#metric-select {
    width: 30;
}

#test-select {
    width: 40;
}

#metrics-controls {
    height: 3;
    margin-bottom: 1;
    align-vertical: middle;
}

#metrics-status {
    margin-left: 2;
    color: $text-muted;
    content-align: left middle;
}

#metrics-summary {
    height: 3;
    margin-bottom: 1;
}

.summary-box {
    width: 1fr;
    border: round $panel;
    content-align: center middle;
    margin: 0 1;
    background: $surface;
}

#metrics-table {
    height: 1fr;
    border: round $panel;
}

#folder-pick-panel {
    height: auto;
    margin-top: 0;
    max-height: 20;
}
